generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  WARGA
  PENGURUS
  ADMIN
}

enum StatusWarga {
  AKTIF
  PINDAH
  MENINGGAL
}

enum StatusSurat {
  PENDING
  DIPROSES
  SELESAI
  DITOLAK
}

enum JenisTransaksi {
  PEMASUKAN
  PENGELUARAN
}

enum StatusLaporan {
  PENDING
  DIPROSES
  SELESAI
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?
  role         Role      @default(WARGA)
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  warga        Warga?
  auditLogs    AuditLog[]

  @@index([email])
  @@index([role])
}

model Warga {
  id               String       @id @default(uuid())
  userId           String?      @unique
  nik              String       @unique
  noKK             String?
  nama             String
  jenisKelamin     String       @default("L") // L / P
  tempatLahir      String?
  tanggalLahir     DateTime?
  agama            String?      @default("Islam")
  pendidikan       String?
  pekerjaan        String?
  statusPernikahan String?      @default("Menikah")
  statusKeluarga   String?      @default("Kepala Keluarga")
  alamat           String
  blok             String       @default("A")
  noRumah          String       @default("1")
  rt               String       @default("04")
  rw               String       @default("09")
  telepon          String?
  email            String?
  status           StatusWarga  @default(AKTIF)
  fotoUrl          String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  pengurus         Pengurus?
  suratList        Surat[]
  laporanList      LaporanKeamanan[]

  @@index([nik])
  @@index([nama])
  @@index([blok])
  @@index([rt, rw])
  @@index([status])
}

model Pengurus {
  id               String    @id @default(uuid())
  wargaId          String    @unique
  jabatan          String    // Ketua RT, Sekretaris, Bendahara, Seksi Keamanan, Humas, dll.
  periode          String    @default("2024-2027")
  skPengangkatan   String?
  statusAktif      Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  warga            Warga     @relation(fields: [wargaId], references: [id], onDelete: Cascade)

  @@index([jabatan])
}

model Surat {
  id               String       @id @default(uuid())
  nomorSurat       String?      @unique
  wargaId          String
  jenisSurat       String       // Keterangan Domisili, SKCK, Usaha, Kematian, dll.
  keperluan        String
  status           StatusSurat  @default(PENDING)
  catatan          String?
  fileDokumenUrl   String?      // S3 file link
  tanggalPengajuan DateTime     @default(now())
  tanggalSelesai   DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  warga            Warga        @relation(fields: [wargaId], references: [id], onDelete: Cascade)

  @@index([wargaId])
  @@index([status])
  @@index([tanggalPengajuan])
}

model Keuangan {
  id               String          @id @default(uuid())
  kodeTransaksi    String?         @unique
  jenis            JenisTransaksi
  kategori         String          // Iuran Warga, Kas RT, Donasi, Keamanan, Sampah, Listrik, Perbaikan
  jumlah           Decimal         @db.Decimal(15, 2)
  keterangan       String?
  buktiBayarUrl    String?         // S3 receipt link
  dicatatOleh      String?         // Nama/ID pencatat
  tanggal          DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([jenis])
  @@index([kategori])
  @@index([tanggal])
}

model LaporanKeamanan {
  id               String          @id @default(uuid())
  nomorLaporan     String?         @unique
  pelaporId        String
  judul            String
  deskripsi        String
  lokasi           String?
  status           StatusLaporan   @default(PENDING)
  tingkatUrgensi   String          @default("SEDANG") // RENDAH, SEDANG, TINGGI, DARURAT
  fotoBuktiUrl     String?         // S3 image link
  tindakan         String?
  tanggal          DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  pelapor          Warga           @relation(fields: [pelaporId], references: [id], onDelete: Cascade)

  @@index([pelaporId])
  @@index([status])
  @@index([tanggal])
}

model AuthCode {
  id          String   @id @default(uuid())
  code        String   @unique
  role        Role     @default(WARGA)
  description String?
  active      Boolean  @default(true)
  usedCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([code])
}

model AuditLog {
  id               String       @id @default(uuid())
  userId           String?
  action           String       // CREATE_WARGA, UPDATE_PROFILE, DELETE_WARGA, UPLOAD_S3
  resource         String
  details          String?
  ipAddress        String?
  createdAt        DateTime     @default(now())

  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

enum LlmStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model LlmQueue {
  id           String      @id @default(uuid())
  taskType     String      // e.g., "SUMMARIZE_LAPORAN", "GENERATE_EMBEDDING"
  payload      Json
  status       LlmStatus   @default(PENDING)
  result       Json?
  errorMessage String?
  retryCount   Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@index([taskType])
}

model KnowledgeDocument {
  id             String    @id @default(uuid())
  filename       String
  fileType       String    // "CSV", "TXT", "JSON", "JSONL"
  version        String    @default("1.0")
  status         String    @default("PROCESSED") // QUEUED, PROCESSING, COMPLETED, FAILED, PARTIALLY_COMPLETED
  classification String    @default("INTERNAL") // PUBLIC, INTERNAL, CONFIDENTIAL, RESTRICTED
  recordsTotal   Int       @default(0)
  recordsFailed  Int       @default(0)
  errorMessage   String?
  fingerprint    String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  chunks         KnowledgeChunk[]

  @@index([status])
  @@index([classification])
}

model KnowledgeChunk {
  id             String    @id @default(uuid())
  documentId     String
  content        String
  metadata       Json?     // { source, category, section, title }
  order          Int       @default(0)
  createdAt      DateTime  @default(now())
  
  document       KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}
