generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Warga {
  id           String    @id @default(uuid())
  nik          String    @unique
  nama         String
  alamat       String?
  telepon      String?
  status       String    @default("aktif") // aktif, pindah, meninggal
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  pengurus     Pengurus?
  surat        Surat[]
  keamanan     LaporanKeamanan[]
}

model Pengurus {
  id           String    @id @default(uuid())
  wargaId      String    @unique
  jabatan      String
  periode      String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  warga        Warga     @relation(fields: [wargaId], references: [id], onDelete: Cascade)
}

model Surat {
  id           String    @id @default(uuid())
  wargaId      String
  jenis        String
  status       String    @default("pending") // pending, diproses, selesai, ditolak
  keterangan   String?
  lampiran     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  warga        Warga     @relation(fields: [wargaId], references: [id], onDelete: Cascade)
}

model Keuangan {
  id           String    @id @default(uuid())
  jenis        String    // pemasukan, pengeluaran
  kategori     String
  jumlah       Float
  keterangan   String?
  tanggal      DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model LaporanKeamanan {
  id           String    @id @default(uuid())
  pelaporId    String
  jenis        String
  deskripsi    String
  status       String    @default("pending") // pending, diproses, selesai
  tanggal      DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  pelapor      Warga     @relation(fields: [pelaporId], references: [id], onDelete: Cascade)
}
